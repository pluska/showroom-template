# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.wrangler/
.open-next

/.claude

# drive downloads
public/drive-download-*

# Drop de originales del cliente (PNG 4K de 12-19 MB cada uno). Es material
# fuente: se convierte a WebP y se sube a R2, no se versiona. Ver docs/02-ASSETS.md
/FASES/
/ENTREGAS/
# Drop de iconos del cliente, con nombres de carpeta con espacios y acentos.
# La copia que usa la app vive aplanada bajo public/icons/.
/public/new_ICONOS/
# Videos fuente sueltos en public/: Cloudflare Pages rechaza cualquier asset
# de más de 25 MiB y tumba el build. Los videos se sirven desde R2.
public/**/*.mp4
public/*.mp4
public/**/*.mov
public/*.mov

# Semilla local de usuarios con hashes reales. La plantilla versionada es
# src/lib/db/insert-users.sql; las credenciales de verdad nunca se commitean.
.users.local.sql
