# Database Configuration (Drizzle Studio / migraciones locales)
# Ruta al SQLite de la D1 local que crea miniflare al correr `npm run db:migrate`:
# file:./.wrangler/state/v3/d1/miniflare-D1DatabaseObject/<hash>.sqlite
DATABASE_URL=""

# NextAuth
# Genera un secreto: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# R2 Storage (Cloudflare)
# NEXT_PUBLIC_R2_PUBLIC_URL es el que consume src/utils/assets.ts
R2_BUCKET_NAME="PROJECT-showroom"
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Mapa
# Estilo propio de Mapbox (mapbox://styles/<cuenta>/<id>). Vacío = mapbox/light-v11.
NEXT_PUBLIC_MAPBOX_STYLE_URL=""
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# Email Service
RESEND_API_KEY=""
OPENAI_API_KEY=""
