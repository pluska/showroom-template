# Base de datos (Drizzle Studio / migraciones locales)
# Ruta al SQLite de la D1 local que crea miniflare al correr `npm run db:migrate`:
# file:./.wrangler/state/v3/d1/miniflare-D1DatabaseObject/<hash>.sqlite
DATABASE_URL=""

# NextAuth
# Genera un secreto: openssl rand -base64 32
# Sin este valor el login no funciona: no hay valor por defecto a propósito,
# un secreto compartido entre proyectos permitiría forjar sesiones.
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# R2 (Cloudflare) — cada proyecto tiene SU bucket.
# NEXT_PUBLIC_R2_PUBLIC_URL es el que consume src/utils/assets.ts. Vacío = las
# claves se resuelven contra public/, que falla a la vista en vez de en silencio.
R2_BUCKET_NAME="PROJECT-showroom"
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Rompe la caché del navegador cuando se reemplaza el contenido de una clave
# que ya estaba en el bucket. Se sube con `npm run assets:bump`.
NEXT_PUBLIC_ASSET_VERSION=""

# Mapa
# Estilo propio de Mapbox (mapbox://styles/<cuenta>/<id>). Vacío = mapbox/light-v11.
NEXT_PUBLIC_MAPBOX_STYLE_URL=""
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# Correo (Resend). Sin la clave las reservas se guardan igual y solo se
# omite el aviso por correo.
RESEND_API_KEY=""

# Módulo de Contenido (generación con IA). Sin OPENAI_API_KEY el módulo sigue
# abriéndose y cae a los textos/imágenes de reserva de src/lib/content/fallback.ts.
OPENAI_API_KEY=""
OPENAI_COPY_MODEL=""
OPENAI_IMAGE_MODEL=""
OPENAI_IMAGE_QUALITY=""
OPENAI_ORCHESTRATOR_MODEL=""

# Google Meet para las citas del calendario (opcional). Sin estas tres la cita
# se agenda igual, solo que sin enlace de videollamada.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
